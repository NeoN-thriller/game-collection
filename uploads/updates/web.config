<?xml version="1.0" encoding="UTF-8"?>
<!-- Release zips are only served through api/update_file.php — never directly (IIS) -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="/" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
