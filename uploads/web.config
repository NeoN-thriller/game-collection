<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS equivalent of uploads/.htaccess (ignored by Apache) -->
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />
        <!-- Nothing in uploads may run as a script -->
        <handlers accessPolicy="Read" />
        <security>
            <requestFiltering>
                <!-- Each one removed first: IIS already blocks some of them (e.g. .config) server-wide,
                     and adding an entry that already exists breaks every file in this folder (500.19) -->
                <fileExtensions>
                    <remove fileExtension=".php" />    <add fileExtension=".php"    allowed="false" />
                    <remove fileExtension=".phtml" />  <add fileExtension=".phtml"  allowed="false" />
                    <remove fileExtension=".phar" />   <add fileExtension=".phar"   allowed="false" />
                    <remove fileExtension=".asp" />    <add fileExtension=".asp"    allowed="false" />
                    <remove fileExtension=".aspx" />   <add fileExtension=".aspx"   allowed="false" />
                    <remove fileExtension=".config" /> <add fileExtension=".config" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
        <!-- Uploaded files are data only: no scripts, even inside SVG icons -->
        <httpProtocol>
            <customHeaders>
                <remove name="Content-Security-Policy" />
                <add name="Content-Security-Policy" value="default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
